---
import { X } from 'lucide-react';

const PAGE_URL = '/compounds/7-oh-ban';
// Updated by scripts/update-ban-status.mjs after checking the Federal Register.
const LAST_CHECKED = '2026-09-21';
const lastCheckedLabel = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(LAST_CHECKED));
---

<aside aria-label="Federal scheduling status" data-scheduling-banner class="relative bg-signal/12 pt-[env(safe-area-inset-top)] text-foreground">
  <a
    href={PAGE_URL}
    class="flex min-h-11 items-center justify-center gap-2 px-3 py-2 pr-14 text-left text-sm leading-snug hover:bg-signal/8 min-[820px]:px-14 min-[820px]:text-center"
  >
    <span class="size-2 shrink-0 rounded-full bg-signal" aria-hidden="true"></span>
    <span class="min-w-0 text-foreground">
      <span class="font-semibold">Federal bans:</span>{' '}
      Proposed for <span class="whitespace-nowrap">7-OH.</span> In effect for pseudo and <span class="whitespace-nowrap">MGM-15.</span>{' '}
      <span class="whitespace-nowrap text-muted-foreground">
        <time datetime={LAST_CHECKED}>Last checked {lastCheckedLabel}</time> &rarr;
      </span>
    </span>
  </a>
  <button
    data-dismiss-scheduling-banner
    type="button"
    aria-label="Dismiss announcement"
    class="absolute right-1.5 top-1/2 inline-flex size-11 -translate-y-1/2 items-center justify-center rounded-lg text-muted-foreground hover:bg-signal/15 hover:text-foreground"
  >
    <X class="size-4" aria-hidden="true" />
  </button>
</aside>

<script>
  const banner = document.querySelector<HTMLElement>('[data-scheduling-banner]');
  const dismiss = banner?.querySelector<HTMLButtonElement>('[data-dismiss-scheduling-banner]');
  dismiss?.addEventListener('click', () => {
    document.documentElement.dataset.schedulingBanner = 'hidden';
    try {
      localStorage.setItem('scheduling-banner-dismissed-2026-08-26', '1');
    } catch {
      // The page-level state still applies when storage is unavailable.
    }
  });
</script>
