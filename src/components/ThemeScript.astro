---
// Runs before paint. The `theme` key remains compatible with the previous UI.
---
<script is:inline>
  (function () {
    var root = document.documentElement;
    var media = window.matchMedia('(prefers-color-scheme: dark)');

    function storedMode() {
      try {
        var value = localStorage.getItem('theme');
        return value === 'light' || value === 'dark' ? value : 'system';
      } catch (error) {
        return 'system';
      }
    }

    function apply(mode) {
      var dark = mode === 'dark' || (mode === 'system' && media.matches);
      root.classList.toggle('dark', dark);
      root.dataset.themeMode = mode;
      root.style.colorScheme = dark ? 'dark' : 'light';
    }

    apply(storedMode());
    try {
      if (localStorage.getItem('desktop-sidebar-collapsed') === '1') {
        root.dataset.sidebarCollapsed = 'true';
      }
    } catch (error) {
      // Storage blocked: use the expanded desktop sidebar.
    }
    try {
      var bannerPath = window.location.pathname.replace(/\/$/, '');
      if (
        bannerPath === '/compounds/7-oh-ban' ||
        localStorage.getItem('scheduling-banner-dismissed-2026-08-26') === '1'
      ) {
        root.dataset.schedulingBanner = 'hidden';
      }
    } catch (error) {
      // Storage blocked: leave the time-sensitive notice visible.
    }
    media.addEventListener('change', function () {
      if (storedMode() === 'system') apply('system');
    });
  })();
</script>
