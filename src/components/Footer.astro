---
import Logo from './Logo.astro';
import { SITE } from '~/lib/site';

const year = new Date().getFullYear();
---

<footer class="bg-muted/45 text-foreground">
  <div class="mx-auto max-w-[94rem] px-4 py-9 sm:px-6 sm:py-11 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-[1.25fr_0.8fr_0.95fr] lg:gap-12">
      <div class="max-w-md">
        <Logo size="2.25rem" />
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground">{SITE.description}</p>
        <p class="mt-3 text-xs leading-relaxed text-muted-foreground">
          Community-compiled information, not medical advice. A qualified clinician who knows your situation should guide medical decisions.
        </p>
      </div>

      <div>
        <p class="eyebrow !text-muted-foreground">Need help now</p>
        <ul class="mt-3 space-y-2.5 text-sm font-semibold">
          <li><a href="/resources/crisis-hotlines" class="hover:text-primary">Crisis and urgent help</a></li>
          <li><a href="/start-here/7-oh-withdrawal-help" class="hover:text-primary">Withdrawal help</a></li>
          <li><a href="/next-kratom-support-meeting" class="hover:text-primary">Next support meeting</a></li>
          <li><a href="https://findtreatment.gov" target="_blank" rel="noopener noreferrer" class="hover:text-primary">Find treatment ↗</a></li>
        </ul>
      </div>

      <div>
        <p class="eyebrow !text-muted-foreground">Site and community</p>
        <ul class="mt-3 grid grid-cols-2 gap-x-5 gap-y-2.5 text-sm text-muted-foreground">
          <li><a href="/sitemap" class="hover:text-primary">Site map</a></li>
          <li><a href="/about/changelog" class="hover:text-primary">Changelog</a></li>
          <li><a href="/about/the-community" class="hover:text-primary">Community</a></li>
          <li><a href="/about/this-site" class="hover:text-primary">About</a></li>
          <li><a href="https://www.reddit.com/r/quitting7oh/" target="_blank" rel="noopener noreferrer" class="hover:text-primary">Reddit ↗</a></li>
          <li><a href="https://discord.gg/quitting7oh" target="_blank" rel="noopener noreferrer" class="hover:text-primary">Discord ↗</a></li>
          <li><a href={SITE.repo} target="_blank" rel="noopener noreferrer" class="hover:text-primary">GitHub ↗</a></li>
          <li><a href="/brand" class="hover:text-primary">Brand guide</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-2 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.title}.org</p>
      <p>No accounts. No tracking. No monetization.</p>
    </div>
  </div>
</footer>
