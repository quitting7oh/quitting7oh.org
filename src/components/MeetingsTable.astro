---
/** Renders one fellowship's meeting schedule as an inline table from
 *  the structured data in src/data/meetings.ts. The meetings page
 *  (meeting-schedules.mdx) embeds this twice, once per fellowship.
 *
 *  Multi-day recurrences (e.g. "Mon, Wed, Fri at 10am") collapse into
 *  a single row so the table communicates the *pattern* of the schedule
 *  rather than enumerating every day independently. */
import { MEETINGS, FELLOWSHIPS, type Fellowship, type Meeting } from '~/data/meetings';

interface Props {
  fellowship: Fellowship;
  /** "schedule" renders the day-by-day meeting table (default).
   *  "zoom-lookup" renders the shortlink → full Zoom URL lookup for KA. */
  variant?: 'schedule' | 'zoom-lookup';
}

const { fellowship, variant = 'schedule' } = Astro.props;
const meta = FELLOWSHIPS[fellowship];

const DAY_FULL = [
  'Sunday',
  'Monday',
  'Tuesday',
  'Wednesday',
  'Thursday',
  'Friday',
  'Saturday',
] as const;
const DAY_SHORT = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'] as const;

/** Rank days starting Monday so sort order matches the canonical week. */
function monRank(dow: number): number {
  return (dow + 6) % 7;
}

function formatDayCell(days: number[]): string {
  if (days.length === 7) return 'Daily (Mon–Sun)';
  if (days.length === 1) return DAY_FULL[days[0]];
  // Sort Mon-first
  const sorted = [...days].sort((a, b) => monRank(a) - monRank(b));
  // If contiguous run, dash. Otherwise comma list.
  const ranks = sorted.map(monRank);
  const contiguous = ranks.every((r, i) => i === 0 || r === ranks[i - 1] + 1);
  if (contiguous && sorted.length >= 3) {
    return `${DAY_FULL[sorted[0]]}–${DAY_FULL[sorted[sorted.length - 1]]}`;
  }
  // Short labels for compact display when comma-separated
  return sorted.map((d) => DAY_SHORT[d]).join(', ');
}

function format12hET(hour: number, minute: number): string {
  const period = hour >= 12 ? 'PM' : 'AM';
  const h = hour % 12 === 0 ? 12 : hour % 12;
  return `${h}:${String(minute).padStart(2, '0')} ${period}`;
}

function format12hPT(hour: number, minute: number): string {
  const ptHour = (hour - 3 + 24) % 24;
  return format12hET(ptHour, minute);
}

function shortLinkLabel(url: string): string {
  return url.replace(/^https?:\/\//, '');
}

const rows: Meeting[] = MEETINGS
  .filter((m) => m.fellowship === fellowship)
  .sort((a, b) => {
    const aFirst = Math.min(...a.daysOfWeek.map(monRank));
    const bFirst = Math.min(...b.daysOfWeek.map(monRank));
    if (aFirst !== bFirst) return aFirst - bFirst;
    return a.hourET * 60 + a.minuteET - (b.hourET * 60 + b.minuteET);
  });

// For the URL-lookup view, derive a unique (shortLink, joinUrl) list.
const zoomLookup = (() => {
  const seen = new Set<string>();
  const out: { shortLink: string; joinUrl: string }[] = [];
  for (const m of rows) {
    if (!m.shortLink) continue;
    if (seen.has(m.shortLink)) continue;
    seen.add(m.shortLink);
    out.push({ shortLink: m.shortLink, joinUrl: m.joinUrl });
  }
  return out;
})();
---

{variant === 'zoom-lookup' && (
  <div class="not-prose my-6 overflow-hidden rounded-xl border border-border bg-card">
    <div class="border-b border-border bg-muted/45 px-4 py-3">
      <p class="text-xs font-bold uppercase tracking-[0.12em] text-muted-foreground">Kratom Anonymous · room lookup</p>
    </div>
    <p class="border-b border-border bg-muted/25 px-4 py-2 text-xs font-semibold text-muted-foreground sm:hidden">Swipe to see all columns →</p>
    <div class="overflow-x-auto overscroll-x-contain">
    <table class="w-full min-w-[36rem] border-collapse text-left text-sm">
      <thead class="bg-muted/55 text-[0.7rem] uppercase tracking-[0.08em] text-muted-foreground">
        <tr>
          <th class="px-4 py-3">Shortlink</th>
          <th class="px-4 py-3">Zoom URL</th>
        </tr>
      </thead>
      <tbody>
        {zoomLookup.map((r) => (
          <tr class="border-t border-border first:border-t-0 hover:bg-accent/35">
            <td class="px-4 py-3 font-bold">
              <a class="text-primary underline decoration-primary/30 underline-offset-4" href={r.shortLink} target="_blank" rel="noopener noreferrer">
                {shortLinkLabel(r.shortLink)}
              </a>
            </td>
            <td class="px-4 py-3 font-mono text-xs">
              <a class="text-primary underline decoration-primary/30 underline-offset-4" href={r.joinUrl} target="_blank" rel="noopener noreferrer">
                {shortLinkLabel(r.joinUrl)}
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  </div>
)}

{variant === 'schedule' && fellowship === 'KA' && (
  <div class="not-prose my-6 overflow-hidden rounded-xl border border-border bg-card">
    <div class="flex items-center justify-between gap-3 border-b border-border bg-muted/45 px-4 py-3">
      <p class="text-xs font-bold uppercase tracking-[0.12em] text-muted-foreground">{meta.shortName} · weekly schedule</p>
      <span class="text-xs text-muted-foreground">ET / PT</span>
    </div>
    <p class="border-b border-border bg-muted/25 px-4 py-2 text-xs font-semibold text-muted-foreground sm:hidden">Swipe to see all columns →</p>
    <div class="overflow-x-auto overscroll-x-contain">
    <table class="w-full min-w-[50rem] border-collapse text-left text-sm">
      <thead class="bg-muted/55 text-[0.7rem] uppercase tracking-[0.08em] text-muted-foreground">
        <tr>
          <th class="sticky left-0 z-10 bg-muted px-4 py-3">Day</th>
          <th class="px-4 py-3">Time (ET / PT)</th>
          <th class="px-4 py-3">Format</th>
          <th class="px-4 py-3">Shortlink</th>
          <th class="px-4 py-3">Zoom room</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((m) => (
          <tr class="border-t border-border hover:bg-accent/35">
            <td class="sticky left-0 bg-card px-4 py-3 group-hover:bg-accent">
              <strong>{formatDayCell(m.daysOfWeek)}</strong>
              {m.note && <em class="ml-1">({m.note})</em>}
            </td>
            <td class="whitespace-nowrap px-4 py-3 text-muted-foreground">
              {format12hET(m.hourET, m.minuteET)} ET / {format12hPT(m.hourET, m.minuteET)} PT
            </td>
            <td class="px-4 py-3 font-bold">{m.format}</td>
            <td class="px-4 py-3">
              {m.shortLink ? (
                <a class="font-bold text-primary underline decoration-primary/30 underline-offset-4" href={m.shortLink} target="_blank" rel="noopener noreferrer">
                  {shortLinkLabel(m.shortLink)}
                </a>
              ) : (
                '—'
              )}
            </td>
            <td class="px-4 py-3">
              {m.room ? (
                m.room
              ) : (
                <a class="font-bold text-primary underline decoration-primary/30 underline-offset-4" href={m.joinUrl} target="_blank" rel="noopener noreferrer">
                  {shortLinkLabel(m.joinUrl)}
                </a>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  </div>
)}

{variant === 'schedule' && fellowship === 'KQS' && (
  <div class="not-prose my-6 overflow-hidden rounded-xl border border-border bg-card">
    <div class="flex items-center justify-between gap-3 border-b border-border bg-muted/45 px-4 py-3">
      <p class="text-xs font-bold uppercase tracking-[0.12em] text-muted-foreground">{meta.shortName} · weekly schedule</p>
      <span class="text-xs text-muted-foreground">ET / PT</span>
    </div>
    <p class="border-b border-border bg-muted/25 px-4 py-2 text-xs font-semibold text-muted-foreground sm:hidden">Swipe to see all columns →</p>
    <div class="overflow-x-auto overscroll-x-contain">
    <table class="w-full min-w-[42rem] border-collapse text-left text-sm">
      <thead class="bg-muted/55 text-[0.7rem] uppercase tracking-[0.08em] text-muted-foreground">
        <tr>
          <th class="sticky left-0 z-10 bg-muted px-4 py-3">Day</th>
          <th class="px-4 py-3">Time (ET / PT)</th>
          <th class="px-4 py-3">Meeting</th>
          <th class="px-4 py-3">Join</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((m) => (
          <tr class="border-t border-border hover:bg-accent/35">
            <td class="sticky left-0 bg-card px-4 py-3">
              <strong>{formatDayCell(m.daysOfWeek)}</strong>
            </td>
            <td class="whitespace-nowrap px-4 py-3 text-muted-foreground">
              {format12hET(m.hourET, m.minuteET)} ET / {format12hPT(m.hourET, m.minuteET)} PT
            </td>
            <td class="px-4 py-3 font-bold">{m.format}</td>
            <td class="px-4 py-3">
              <a href={m.joinUrl} target="_blank" rel="noopener noreferrer">
                <span class="inline-flex min-h-11 items-center rounded-lg bg-primary px-3 py-2 text-xs font-bold text-primary-foreground">Join meeting ↗</span>
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  </div>
)}
