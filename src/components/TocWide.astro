---
/**
 * Horizontal "On this page" anchor bar for wide-layout pages, which
 * hide the right-rail TOC to give the content the full container.
 * H2 only — subsections would crowd a single row.
 */
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const sections = headings.filter((h) => h.depth === 2);
---

{
  sections.length > 1 && (
    <nav
      aria-label="Table of contents"
      class="mt-7 flex flex-wrap items-center gap-2 text-sm"
    >
      <span class="eyebrow mr-2 !text-muted-foreground">
        On this page
      </span>
      {sections.map((h) => (
        <a
          href={`#${h.slug}`}
          class="px-1 py-1.5 font-bold text-muted-foreground underline decoration-border underline-offset-4 transition-colors hover:text-primary hover:decoration-primary"
        >
          {h.text}
        </a>
      ))}
    </nav>
  )
}
