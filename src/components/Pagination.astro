---
import type { PaginationNeighbor } from '~/lib/pagination';

interface Props {
  prev?: PaginationNeighbor;
  next?: PaginationNeighbor;
}

const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav
    aria-label="Page navigation"
    class="mt-14 grid gap-8 sm:grid-cols-2"
  >
    {prev ? (
      <a
        href={prev.href}
        rel="prev"
        class="group block py-3"
      >
        <div class="eyebrow !text-muted-foreground">
          ← Previous
        </div>
        <div class="mt-2 font-display text-lg font-semibold leading-tight text-foreground group-hover:text-primary">
          {prev.title}
        </div>
      </a>
    ) : (
      <div class="hidden sm:block" aria-hidden="true"></div>
    )}
    {next && (
      <a
        href={next.href}
        rel="next"
        class="group block py-3 sm:text-right"
      >
        <div class="eyebrow !text-muted-foreground">
          Next →
        </div>
        <div class="mt-2 font-display text-lg font-semibold leading-tight text-foreground group-hover:text-primary">
          {next.title}
        </div>
      </a>
    )}
  </nav>
)}
