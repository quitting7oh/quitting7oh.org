---
import BaseLayout from './BaseLayout.astro';
import { AppSidebar } from '~/components/AppSidebar';
import { Toc } from '~/components/Toc';
import { TocMobile } from '~/components/TocMobile';
import TocWide from '~/components/TocWide.astro';
import { Breadcrumbs } from '~/components/Breadcrumbs';
import { getCategory, PINNED_PAGES } from '~/lib/categories';
import { getSidebarCategories } from '~/lib/sidebar-data';
import { getPrevNext } from '~/lib/pagination';
import Pagination from '~/components/Pagination.astro';
import { viewOnGithubUrl } from '~/lib/site';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description?: string;
  category: string;
  lastUpdated?: Date;
  filePath: string; // e.g. "start-here/welcome.md"
  headings: MarkdownHeading[];
  /** Wide layout: hides the right TOC, lets the main column take the full
   *  container. For reference docs (charts/diagrams) that need horizontal
   *  room and don't really benefit from a TOC. */
  wide?: boolean;
}

const {
  title,
  description,
  category,
  lastUpdated,
  filePath,
  headings,
  wide = false,
} = Astro.props;
const cat = getCategory(category);
const sourceUrl = viewOnGithubUrl(filePath);
const updatedStr = lastUpdated
  ? lastUpdated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : undefined;

const sidebarCategories = await getSidebarCategories();
const currentPath = Astro.url.pathname;
const { prev, next } = await getPrevNext(currentPath);
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto flex max-w-[96rem] items-stretch">
    <AppSidebar
      client:load
      categories={sidebarCategories}
      pinned={PINNED_PAGES}
      currentPath={currentPath}
    />
    <main id="main-content" class="min-w-0 flex-1">
      <header class="bg-card/55">
        <div class="min-w-0 px-4 py-7 sm:px-8 sm:py-8 lg:px-10 lg:py-8">
          <div class:list={['mx-auto', wide ? 'max-w-6xl' : 'max-w-[50rem]']}>
              <Breadcrumbs
                client:idle
                crumbs={[
                  ...(cat ? [{ label: cat.title, href: `/${cat.slug}` }] : []),
                  { label: title },
                ]}
                sharePath={currentPath}
              />
              {cat && <p class="eyebrow mt-4">{cat.title} · Field note</p>}
              <h1 class="mt-2.5 font-display text-[clamp(2.05rem,3vw,2.4rem)] font-semibold leading-[1.08] tracking-[-0.018em] text-foreground">
                {title}
              </h1>
              {description && (
                <p class="mt-3.5 max-w-[44rem] text-base leading-[1.65] text-muted-foreground sm:text-[1.0625rem]">{description}</p>
              )}
              {!wide && <div class="mt-6 xl:hidden"><TocMobile headings={headings} client:idle /></div>}
              {wide && <TocWide headings={headings} />}
          </div>
        </div>
      </header>

      <div class:list={['grid min-w-0', !wide && 'xl:grid-cols-[minmax(0,1fr)_15rem]']}>
        <div class="min-w-0 px-4 py-7 sm:px-8 sm:py-8 lg:px-10 lg:py-9">
          <div class:list={['mx-auto min-w-0', wide ? 'max-w-6xl' : 'max-w-[50rem]']}>
            <article class="prose-recovery dark:prose-invert" data-pagefind-body>
              <slot />
            </article>

            <Pagination prev={prev} next={next} />

            <div class="mt-12 flex flex-col gap-3 rounded-xl bg-muted/55 px-4 py-3.5 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
              {updatedStr && <span>Updated <time datetime={lastUpdated?.toISOString()}>{updatedStr}</time></span>}
              <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-primary underline decoration-primary/35 underline-offset-4 hover:decoration-primary">
                Read or suggest an edit on GitHub ↗
              </a>
            </div>
          </div>
        </div>

        {!wide && (
          <aside class="hidden px-4 py-8 xl:block">
            <div class="sticky top-[6.5rem]">
              <Toc headings={headings} client:idle />
            </div>
          </aside>
        )}
      </div>
    </main>
    <div id="copy-announce" aria-live="polite" class="sr-only"></div>
  </div>
</BaseLayout>

<script>
  // Heading anchors copy the section URL instead of navigating. The hash
  // still lands in the address bar (replaceState, no scroll jump) so the
  // copied link matches what the reader sees.
  const live = document.getElementById('copy-announce');
  const timers = new WeakMap<Element, number>();

  document.addEventListener('click', (event) => {
    // Modified clicks (new tab, etc.) keep normal anchor behavior.
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const target = event.target instanceof Element ? event.target : null;
    const anchor = target?.closest('a.heading-anchor');
    if (!(anchor instanceof HTMLAnchorElement)) return;
    event.preventDefault();
    const url = new URL(anchor.getAttribute('href') ?? '', window.location.href);
    navigator.clipboard
      .writeText(url.href)
      .then(() => {
        history.replaceState(null, '', url.hash);
        anchor.setAttribute('data-copied', '');
        if (live) live.textContent = 'Link copied to clipboard';
        window.clearTimeout(timers.get(anchor));
        timers.set(
          anchor,
          window.setTimeout(() => {
            anchor.removeAttribute('data-copied');
            if (live) live.textContent = '';
          }, 1600),
        );
      })
      .catch(() => {
        // Clipboard unavailable: fall back to plain anchor navigation.
        window.location.hash = url.hash;
      });
  });
</script>

<script>
  // A URL hash is positioned before client islands finish hydrating. The
  // scheduling notice and other early islands can add height above the target
  // afterward, leaving the requested section partly adrift. Re-align headings
  // briefly while the page settles, but stop immediately if the reader starts
  // navigating on their own.
  let hashAlignmentRun = 0;

  const currentHeading = () => {
    if (!window.location.hash) return null;
    let id = window.location.hash.slice(1);
    try {
      id = decodeURIComponent(id);
    } catch {
      return null;
    }
    const target = document.getElementById(id);
    return target?.matches('h2, h3, h4, h5, h6') ? target : null;
  };

  const anchorOffset = () => {
    const value = Number.parseFloat(
      window.getComputedStyle(document.documentElement).scrollPaddingTop,
    );
    return Number.isFinite(value) ? value : 104;
  };

  const alignCurrentHeading = () => {
    const target = currentHeading();
    if (!target) return;
    const delta = target.getBoundingClientRect().top - anchorOffset();
    if (Math.abs(delta) < 1) return;

    // Temporarily bypass the document's smooth-scroll rule. Repeated smooth
    // corrections would queue animations while the page is still settling.
    const root = document.documentElement;
    const previousBehavior = root.style.scrollBehavior;
    root.style.scrollBehavior = 'auto';
    window.scrollTo(0, window.scrollY + delta);
    root.style.scrollBehavior = previousBehavior;
  };

  const stabilizeHeadingHash = () => {
    if (!currentHeading()) return;
    const run = ++hashAlignmentRun;
    const cancel = () => {
      if (hashAlignmentRun === run) hashAlignmentRun += 1;
      cleanup();
    };
    const cleanup = () => {
      window.removeEventListener('wheel', cancel);
      window.removeEventListener('touchstart', cancel);
      window.removeEventListener('pointerdown', cancel);
      window.removeEventListener('keydown', cancel);
    };
    const align = () => {
      if (hashAlignmentRun === run) alignCurrentHeading();
    };

    window.addEventListener('wheel', cancel, { passive: true });
    window.addEventListener('touchstart', cancel, { passive: true });
    window.addEventListener('pointerdown', cancel, { passive: true });
    window.addEventListener('keydown', cancel);

    window.requestAnimationFrame(() => {
      align();
      window.requestAnimationFrame(align);
    });
    window.setTimeout(align, 120);
    window.setTimeout(align, 360);
    window.setTimeout(() => {
      align();
      cleanup();
    }, 760);
  };

  window.addEventListener('hashchange', stabilizeHeadingHash);
  stabilizeHeadingHash();
</script>
