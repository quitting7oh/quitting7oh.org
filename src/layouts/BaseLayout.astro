---
import '~/styles/global.css';
import ThemeScript from '~/components/ThemeScript.astro';
import Header from '~/components/Header.astro';
import { BackToTop } from '~/components/BackToTop';
import { CrisisButton } from '~/components/CrisisButton';
import { SchedulingBanner } from '~/components/SchedulingBanner';
import Footer from '~/components/Footer.astro';
import { SITE } from '~/lib/site';

interface Props {
  title?: string;
  description?: string;
  /** When true, render the canonical URL as the homepage. */
  canonical?: string;
}

const { title, description = SITE.description, canonical } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}.org` : `${SITE.title}.org — recovery information`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <ThemeScript />
    <link rel="icon" href="/favicons/rose/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicons/rose/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicons/rose/apple-touch-icon.png" />
    <link rel="manifest" href="/favicons/rose/site.webmanifest" />
    {/* Open Graph (Discord, LinkedIn, Slack, Facebook). The brand-
        anchored og-image carries the Lift Cup lockup + wordmark on
        the stone-light background — generated once by
        scripts/build-og-image.mjs and committed as a static PNG. */}
    <meta property="og:site_name" content={`${SITE.title}.org`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${SITE.url}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="quitting7oh.org — recovery information for 7-OH, MGM-15, and kratom-derived synthetics" />
    {/* Twitter / X. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE.url}/og-image.png`} />
    <meta name="twitter:image:alt" content="quitting7oh.org — recovery information for 7-OH, MGM-15, and kratom-derived synthetics" />
    <meta name="theme-color" content="#faf8f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191512" media="(prefers-color-scheme: dark)" />
    <meta name="robots" content="index,follow" />
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SchedulingBanner client:load />
    <Header />
    <slot />
    <Footer />
    <BackToTop client:idle />
    <CrisisButton client:load />
  </body>
</html>
