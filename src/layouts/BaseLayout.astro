---
import '~/styles/global.css';
import ThemeScript from '~/components/ThemeScript.astro';
import Header from '~/components/Header.astro';
import { BackToTop } from '~/components/BackToTop';
import SchedulingBanner from '~/components/SchedulingBanner.astro';
import Footer from '~/components/Footer.astro';
import { routePath, SITE } from '~/lib/site';
import { serializeJsonLd, siteGraph } from '~/lib/structured-data';
import bodyFontUrl from '@fontsource-variable/commissioner/files/commissioner-latin-standard-normal.woff2?url';
import displayFontUrl from '@fontsource-variable/stix-two-text/files/stix-two-text-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** When true, render the canonical URL as the homepage. */
  canonical?: string;
  /** Minimal chrome for the withdrawal fast-path. */
  minimal?: boolean;
  /** Keep the reading-progress escape hatch available without restoring full chrome. */
  showBackToTop?: boolean;
  /** Exclude unlisted pages from search-engine results. */
  noindex?: boolean;
  /** Open Graph type: 'article' for content pages, 'website' elsewhere. */
  ogType?: 'website' | 'article';
  /** Emitted as article:modified_time when ogType is 'article'. */
  modifiedTime?: Date;
  /** Page-level JSON-LD nodes added to the site-wide graph. Dropped on
   *  noindex pages. */
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  canonical,
  minimal = false,
  showBackToTop = !minimal,
  noindex = false,
  ogType = 'website',
  modifiedTime,
  structuredData = [],
} = Astro.props;
// Search engines truncate or ignore titles over 70 characters (Bing's site
// scan flags them), so drop the site suffix when a long page title would
// push the full string past that.
const MAX_TITLE_LENGTH = 70;
const suffixedTitle = title ? `${title} · ${SITE.title}.org` : '';
const pageTitle = !title
  ? `7-OH Withdrawal Help & Taper Guides | ${SITE.title}.org`
  : suffixedTitle.length > MAX_TITLE_LENGTH
    ? title
    : suffixedTitle;
const canonicalUrl = canonical ?? new URL(routePath(Astro.url.pathname), SITE.url).toString();
const jsonLd = serializeJsonLd([...siteGraph(), ...(noindex ? [] : structuredData)]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <ThemeScript />
    <link rel="preload" href={bodyFontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicons/stone/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicons/stone/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicons/stone/apple-touch-icon.png" />
    <link rel="manifest" href="/favicons/stone/site.webmanifest" />
    {/* Open Graph (Discord, LinkedIn, Slack, Facebook). The brand-
        anchored og-image carries the Lift Cup lockup + wordmark on
        the stone-light background — generated once by
        scripts/build-og-image.mjs and committed as a static PNG. */}
    <meta property="og:site_name" content={`${SITE.title}.org`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString().slice(0, 10)} />
    )}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${SITE.url}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="quitting7oh.org — recovery information for 7-OH, MGM-15, and kratom-derived synthetics" />
    {/* Twitter / X. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE.url}/og-image.png`} />
    <meta name="twitter:image:alt" content="quitting7oh.org — recovery information for 7-OH, MGM-15, and kratom-derived synthetics" />
    <meta name="theme-color" content="#f8f5ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#211a15" media="(prefers-color-scheme: dark)" />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <script type="application/ld+json" set:html={jsonLd} />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-1ZPHE0EXTM" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-1ZPHE0EXTM');
    </script>
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <a class="skip-link" href="#main-content">Skip to content</a>
    {!minimal && <SchedulingBanner />}
    {!minimal && <Header />}
    <slot />
    {!minimal && <Footer />}
    {showBackToTop && <BackToTop client:idle />}
  </body>
</html>
