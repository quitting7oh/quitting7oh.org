---
import BaseLayout from '~/layouts/BaseLayout.astro';
const title = 'Find a SMART Recovery meeting';
const description =
  'We have retired our SMART meeting finder. Find current meeting times and join links on the SMART Recovery website.';
---

<BaseLayout title={title} description={description}>
  <main
    id="main-content"
    class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12"
  >
    <header class="mb-10 sm:mb-12">
      <p class="eyebrow">Mutual aid</p>
      <h1 class="mt-3 max-w-4xl font-display text-[clamp(2.1rem,3.2vw,2.5rem)] font-semibold leading-[1.08] tracking-[-0.018em] text-foreground">
        Find a SMART Recovery meeting
      </h1>

      <div class="mt-6 max-w-2xl rounded-lg border border-border border-l-4 border-l-primary bg-muted/50 p-5 text-base leading-relaxed text-muted-foreground">
        <p class="m-0">
          We can no longer refresh SMART meeting listings, so we have
          retired this site's SMART meeting finder. Find current meeting
          times and join links on SMART Recovery's website.
        </p>
        <a
          href="https://meetings.smartrecovery.org/meetings/?meetingType=1"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex min-h-11 items-center gap-2 rounded-lg bg-primary px-4 py-3 text-sm font-bold text-primary-foreground hover:bg-primary/90"
        >
          Find a meeting on SMART Recovery
          <span aria-hidden="true">↗</span>
        </a>
        <p class="mb-0 mt-3 text-sm">Opens SMART Recovery's meeting finder in a new tab.</p>
      </div>
      <p class="mt-4 text-sm text-muted-foreground">
        quitting7oh.org is not affiliated with SMART Recovery.
      </p>
    </header>

    <footer class="mt-16 border-t border-border pt-6 text-sm text-muted-foreground">
      <p>
        You can also find{' '}
        <a
          href="/virtual-na-meetings-now"
          class="font-medium text-foreground underline underline-offset-2 hover:text-primary"
        >
          live NA meetings
        </a> or the{' '}
        <a
          href="/next-kratom-support-meeting"
          class="font-medium text-foreground underline underline-offset-2 hover:text-primary"
        >
          next kratom support meeting
        </a>. The{' '}
        <a
          href="/for-you/mutual-aid"
          class="font-medium text-foreground underline underline-offset-2 hover:text-primary"
        >
          mutual aid page
        </a>{' '}
        covers NA, SMART Recovery, and other fellowships in context.
      </p>
    </footer>
  </main>
</BaseLayout>
