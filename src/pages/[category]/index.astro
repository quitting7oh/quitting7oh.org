---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { AppSidebar } from '~/components/AppSidebar';
import { Breadcrumbs } from '~/components/Breadcrumbs';
import { CATEGORIES, CATEGORY_GROUPS, getCategory, PINNED_PAGES } from '~/lib/categories';
import { getSidebarCategories } from '~/lib/sidebar-data';

export async function getStaticPaths() {
  return CATEGORIES.map((cat) => ({ params: { category: cat.slug } }));
}

const { category } = Astro.params;
const cat = getCategory(category!);
if (!cat) return Astro.redirect('/');

const docs = await getCollection('docs', (d) => !d.data.draft && d.data.category === category);
docs.sort((a, b) => {
  const sa = a.data.sort ?? 999;
  const sb = b.data.sort ?? 999;
  if (sa !== sb) return sa - sb;
  return a.data.title.localeCompare(b.data.title);
});

const sidebarCategories = await getSidebarCategories();
const currentPath = Astro.url.pathname;
const pinnedPaths = new Set(PINNED_PAGES.map((item) => item.href));
const configuredGroups = CATEGORY_GROUPS[cat.slug] ?? [];
const docBySlug = new Map(
  docs.map((doc) => [doc.id.replace(/\.(md|mdx)$/, '').split('/').pop()!, doc]),
);
const groupedSlugs = new Set(configuredGroups.flatMap((group) => group.slugs));
const sections: { name: string | null; docs: typeof docs }[] = configuredGroups.length
  ? configuredGroups
      .map((group) => ({
        name: group.name,
        docs: group.slugs
          .map((slug) => docBySlug.get(slug))
          .filter((doc): doc is (typeof docs)[number] => Boolean(doc)),
      }))
      .filter((group) => group.docs.length > 0)
  : [{ name: null, docs }];

const ungroupedDocs = docs.filter((doc) => {
  const slug = doc.id.replace(/\.(md|mdx)$/, '').split('/').pop()!;
  return !groupedSlugs.has(slug);
});

if (configuredGroups.length && ungroupedDocs.length) {
  sections.push({ name: 'More in this section', docs: ungroupedDocs });
}
---

<BaseLayout title={cat.title} description={cat.blurb}>
  <div class="mx-auto flex max-w-[94rem] items-stretch">
    <main id="main-content" class="min-w-0 flex-1">
      <header class="border-b border-border bg-card px-4 py-7 sm:px-8 sm:py-8 lg:px-10 lg:py-9">
        <div class="mx-auto max-w-[68rem]">
          <Breadcrumbs client:idle crumbs={[{ label: cat.title }]} />
          <div class="mt-4 inline-flex size-9 items-center justify-center rounded-lg bg-accent text-primary">
            <cat.Icon class="size-4.5" aria-hidden="true" />
          </div>
          <h1 class="mt-3 font-display text-[clamp(2.1rem,3.2vw,2.5rem)] font-semibold leading-[1.08] tracking-[-0.018em] text-foreground">
            {cat.title}
          </h1>
          <p class="mt-3.5 max-w-2xl text-base leading-[1.65] text-muted-foreground sm:text-[1.0625rem]">{cat.blurb}</p>
          <p class="mt-3 text-sm font-semibold text-muted-foreground">{docs.length} {docs.length === 1 ? 'page' : 'pages'}</p>
        </div>
      </header>

      <div class="mx-auto max-w-[68rem] px-4 py-8 sm:px-8 sm:py-10 lg:px-10 lg:py-12">

        {docs.length === 0 ? (
          <p class="mt-10 text-muted-foreground">No pages here yet.</p>
        ) : (
          <div class="space-y-12 sm:space-y-14">
            {sections.map((section, sectionIndex) => {
              const precedingCount = sections
                .slice(0, sectionIndex)
                .reduce((total, item) => total + item.docs.length, 0);

              return (
                <section class:list={[
                  section.name && 'lg:grid lg:grid-cols-[11.5rem_minmax(0,1fr)] lg:gap-9',
                ]}>
                  {section.name && (
                    <div class="mb-5 lg:mb-0 lg:pt-4">
                      <h2 class="eyebrow !text-primary">{section.name}</h2>
                      <p class="mt-2 text-xs font-semibold text-muted-foreground">
                        {section.docs.length} {section.docs.length === 1 ? 'page' : 'pages'}
                      </p>
                    </div>
                  )}

                  <ol class="grid gap-x-8 md:grid-cols-2">
                    {section.docs.map((doc, index) => {
                      const slug = doc.id.replace(/\.(md|mdx)$/, '').split('/').pop()!;
                      const href = `/${cat.slug}/${slug}`;
                      const pinned = pinnedPaths.has(href);
                      const updated = doc.data.last_updated?.toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                        year: 'numeric',
                        timeZone: 'UTC',
                      });
                      const displayIndex = precedingCount + index + 1;

                      return (
                        <li class="min-w-0 border-t border-border/70">
                          <a href={href} class="group -mx-3 block h-full rounded-lg px-3 py-5 transition-colors hover:bg-muted/55">
                            <span class="flex items-center justify-between gap-4 text-xs text-muted-foreground">
                              <span class="font-mono font-bold">{String(displayIndex).padStart(2, '0')}</span>
                              <span class="flex items-center gap-3">
                                {updated && <time datetime={doc.data.last_updated?.toISOString()}>{updated}</time>}
                                <span class="text-primary transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
                              </span>
                            </span>
                            <span class="mt-3 flex flex-wrap items-center gap-2">
                              {section.name ? (
                                <h3 class="font-sans text-base font-bold leading-tight text-foreground group-hover:text-primary sm:text-[1.0625rem]">{doc.data.title}</h3>
                              ) : (
                                <h2 class="font-sans text-base font-bold leading-tight text-foreground group-hover:text-primary sm:text-[1.0625rem]">{doc.data.title}</h2>
                              )}
                              {pinned && <span class="rounded-md bg-accent px-1.5 py-0.5 text-[0.65rem] font-bold uppercase tracking-[0.08em] text-primary">Most used</span>}
                            </span>
                            {doc.data.description && (
                              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{doc.data.description}</p>
                            )}
                          </a>
                        </li>
                      );
                    })}
                  </ol>
                </section>
              );
            })}
          </div>
        )}
      </div>
    </main>
    <AppSidebar
      client:load
      categories={sidebarCategories}
      pinned={PINNED_PAGES}
      currentPath={currentPath}
    />
  </div>
</BaseLayout>
