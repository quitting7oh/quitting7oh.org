---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { AppSidebar } from '~/components/AppSidebar';
import { Breadcrumbs } from '~/components/Breadcrumbs';
import { CATEGORIES, getCategory, PINNED_PAGES } from '~/lib/categories';
import { getSidebarCategories } from '~/lib/sidebar-data';

export async function getStaticPaths() {
  return CATEGORIES.map((cat) => ({ params: { category: cat.slug } }));
}

const { category } = Astro.params;
const cat = getCategory(category!);
if (!cat) return Astro.redirect('/');

const docs = await getCollection('docs', (d) => !d.data.draft && d.data.category === category);
docs.sort((a, b) => {
  const sa = a.data.sort ?? 999;
  const sb = b.data.sort ?? 999;
  if (sa !== sb) return sa - sb;
  return a.data.title.localeCompare(b.data.title);
});

const sidebarCategories = await getSidebarCategories();
const currentPath = Astro.url.pathname;
---

<BaseLayout title={cat.title} description={cat.blurb}>
  <div class="mx-auto flex max-w-[94rem] items-stretch lg:border-x lg:border-border">
    <AppSidebar
      client:load
      categories={sidebarCategories}
      pinned={PINNED_PAGES}
      currentPath={currentPath}
    />
    <main id="main-content" class="min-w-0 flex-1">
      <header class="border-b border-border bg-card px-4 py-7 sm:px-8 sm:py-8 lg:px-10 lg:py-9">
        <div class="mx-auto max-w-[48rem]">
          <Breadcrumbs client:idle crumbs={[{ label: cat.title }]} />
          <div class="mt-4 inline-flex size-9 items-center justify-center rounded-lg bg-accent text-primary">
            <cat.Icon class="size-4.5" aria-hidden="true" />
          </div>
          <h1 class="mt-3 font-display text-[clamp(2.1rem,3.2vw,2.5rem)] font-semibold leading-[1.08] tracking-[-0.018em] text-foreground">
            {cat.title}
          </h1>
          <p class="mt-3.5 max-w-2xl text-base leading-[1.65] text-muted-foreground sm:text-[1.0625rem]">{cat.blurb}</p>
        </div>
      </header>

      <div class="mx-auto max-w-[48rem] px-4 py-7 sm:px-8 sm:py-9 lg:px-8 lg:py-9">

        {docs.length === 0 ? (
          <p class="mt-10 text-muted-foreground">No pages here yet.</p>
        ) : (
          <ol class="grid gap-px overflow-hidden rounded-xl border border-border bg-border">
            {docs.map((doc, index) => {
              const slug = doc.id.replace(/\.(md|mdx)$/, '').split('/').pop()!;
              return (
                <li class="bg-card">
                  <a href={`/${cat.slug}/${slug}`} class="group grid gap-2 p-5 transition-colors hover:bg-accent sm:grid-cols-[3rem_minmax(0,1fr)_auto] sm:items-start sm:gap-4 sm:p-6">
                    <span class="font-mono text-xs font-bold text-muted-foreground">{String(index + 1).padStart(2, '0')}</span>
                    <span>
                      <h2 class="font-display text-xl font-semibold leading-tight text-foreground group-hover:text-primary sm:text-2xl">
                        {doc.data.title}
                      </h2>
                    {doc.data.description && (
                        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{doc.data.description}</p>
                    )}
                    </span>
                    <span class="hidden text-primary transition-transform group-hover:translate-x-1 sm:block" aria-hidden="true">→</span>
                  </a>
                </li>
              );
            })}
          </ol>
        )}
      </div>
    </main>
  </div>
</BaseLayout>
