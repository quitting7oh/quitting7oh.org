---
import BaseLayout from '~/layouts/BaseLayout.astro';
import FontSystemPreview from '~/components/FontSystemPreview.astro';

import '@fontsource-variable/literata/standard.css';
import '@fontsource-variable/commissioner/standard.css';
import '@fontsource-variable/stix-two-text/wght.css';

const candidates = [
  {
    name: 'Literata + Commissioner',
    heading: 'Literata',
    body: 'Commissioner',
    fit: 'Literata brings a dense book texture and stays legible in dark mode.',
    tradeoff: 'Long page titles take more height and may feel heavy.',
    displayStack: "'Literata Variable', ui-serif, Georgia, serif",
  },
  {
    name: 'STIX Two Text + Commissioner',
    heading: 'STIX Two Text',
    body: 'Commissioner',
    fit: 'STIX Two Text gives pharmacology and medical references a precise scholarly tone.',
    tradeoff: 'That formality may make support pages feel less personal.',
    displayStack: "'STIX Two Text Variable', ui-serif, Georgia, serif",
  },
];

const sources = [
  { label: 'Commissioner', href: 'https://github.com/kosbarts/Commissioner' },
  { label: 'Literata', href: 'https://github.com/googlefonts/literata' },
  { label: 'STIX Two Text', href: 'https://github.com/stipub/stixfonts' },
];
---

<BaseLayout title="Font Finalists: Literata and STIX Two Text" description="Large reading-scale comparisons of Literata and STIX Two Text headings with Commissioner body and interface type.">
  <main id="main-content">
    <header class="quiet-grid">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
        <p class="eyebrow">Typography lab · finalists</p>
        <h1 class="reading-title mt-4 max-w-4xl">Literata and STIX Two Text at reading scale</h1>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted-foreground">
          Commissioner stays fixed for body copy, labels, navigation, buttons, and numbers. Only the display face changes, and each finalist gets the space of a real article instead of a compact sample card.
        </p>
        <p class="mt-4 max-w-3xl text-sm leading-relaxed text-muted-foreground">
          Compare the long title first, then the section hierarchy and dense reading copy. The wording and dimensions are identical in both specimens. Switch themes before choosing.
        </p>

        <nav aria-label="Font finalists" class="mt-8 flex flex-wrap gap-2">
          {candidates.map((candidate, index) => (
            <a href={`#option-${index + 1}`} class="rounded-lg border border-primary/35 bg-card px-3 py-2 text-sm font-bold text-foreground hover:border-primary hover:text-primary">
              {String(index + 1).padStart(2, '0')} · {candidate.heading}
            </a>
          ))}
        </nav>

        <a href="/font-samples" class="mt-6 inline-flex text-sm font-bold text-primary underline decoration-primary/35 underline-offset-4 hover:decoration-primary">
          Return to the first comparison →
        </a>
      </div>
    </header>

    <div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8">
      {candidates.map((candidate, index) => (
        <FontSystemPreview index={index + 1} label="Finalist" {...candidate} />
      ))}

      <section class="mt-4 rounded-2xl bg-muted/45 p-6 sm:p-8">
        <p class="eyebrow">Open-font sources</p>
        <h2 class="mt-3 font-display text-2xl font-semibold text-foreground">Families in this comparison</h2>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted-foreground">
          We bundle each family through Fontsource. Visitors download the files from quitting7oh.org instead of an outside font host.
        </p>
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-3">
          {sources.map((source) => (
            <a href={source.href} target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-primary hover:underline">{source.label} ↗</a>
          ))}
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
