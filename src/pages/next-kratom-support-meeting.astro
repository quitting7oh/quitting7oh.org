---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { UpcomingMeetings } from '~/components/UpcomingMeetings';
import { PreviouslyJoinedMeetings } from '~/components/PreviouslyJoinedMeetings';

const title = 'Next 7-OH and kratom support meeting';
const description =
  'Live virtual 7-OH and kratom support meeting schedule for Kratom Anonymous and Quitting Kratom Support - There Is A Way Out (TIAWO). See the next meeting, when it starts in your time, and join from any device. Free, no signup.';
---

<BaseLayout title={title} description={description}>
  <main
    id="main-content"
    class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12"
  >
    <header class="mb-9 max-w-3xl sm:mb-11">
      <p class="eyebrow">Live support · local time</p>
      <h1 class="mt-3 font-display text-[clamp(2.1rem,3.2vw,2.5rem)] font-semibold leading-[1.08] tracking-[-0.018em] text-foreground">
        Next 7-OH and kratom support meeting
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-[1.65] text-muted-foreground sm:text-[1.0625rem]">
        Live virtual meetings for 7-OH and kratom recovery every day from{' '}
        <a
          href="https://www.kratom-anonymous.org"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-foreground underline underline-offset-2 hover:text-primary"
        >
          Kratom Anonymous
        </a>{' '}
        and{' '}
        <a
          href="https://kratomquitters.com/meetings"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-foreground underline underline-offset-2 hover:text-primary"
        >
          Quitting Kratom Support - There Is A Way Out
        </a>. Free, no signup, no account. Show up from wherever you are.
        Times below are in your local timezone.
      </p>
    </header>

    <PreviouslyJoinedMeetings providers={['KA', 'KQS']} client:load />
    <UpcomingMeetings client:load />

    <footer class="mt-12 border-t border-border pt-6 text-sm text-muted-foreground">
      <p>
        Looking for the full weekly grid? See the{' '}
        <a
          href="/resources/meeting-schedules"
          class="font-medium text-foreground underline underline-offset-2 hover:text-primary"
        >
          complete meeting schedule
        </a>. Not what you're looking for? The{' '}
        <a
          href="/for-you/mutual-aid"
          class="font-medium text-foreground underline underline-offset-2 hover:text-primary"
        >
          mutual aid page
        </a>{' '}
        covers NA, SMART Recovery, and other groups that aren't
        kratom-specific.
      </p>
    </footer>
  </main>
</BaseLayout>
