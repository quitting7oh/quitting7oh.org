---
import BaseLayout from '~/layouts/BaseLayout.astro';
import RightNow from '~/components/RightNow.astro';
import { AppSidebar } from '~/components/AppSidebar';
import { SearchBox } from '~/components/SearchBox';
import { DiscordOnlineCount } from '~/components/DiscordOnlineCount';
import { CATEGORIES, PINNED_PAGES } from '~/lib/categories';
import { getSidebarCategories } from '~/lib/sidebar-data';
import { getCollection } from 'astro:content';
import {
  Activity,
  ArrowRight,
  Calculator,
  Leaf,
  MessageCircle,
  Pill,
} from 'lucide-react';

const docs = await getCollection('docs', (doc) => !doc.data.draft);
const sidebarCategories = await getSidebarCategories();
const counts = Object.fromEntries(
  CATEGORIES.map((category) => [
    category.slug,
    docs.filter((doc) => doc.data.category === category.slug).length,
  ]),
);

const immediatePaths = [
  {
    href: '/medications-supplements/vitamins-supplements',
    label: 'Vitamins & supplements',
    detail: 'Supplements and mega-dose vitamin C, including what to skip',
  },
  {
    href: '/medications-supplements/helper-meds',
    label: 'Helper medications',
    detail: 'Medication options for common withdrawal symptoms',
  },
  {
    href: '/mat-suboxone/sows-cows-induction-guide',
    label: 'SOWS induction guide',
    detail: 'Score symptoms before a buprenorphine induction',
  },
  {
    href: '/for-loved-ones/welcome',
    label: 'For someone you love',
    detail: 'Help with support and boundaries for families',
  },
];

const tools = [
  { href: '/resources/7-oh-taper-calculator', label: '7-OH taper', Icon: Calculator },
  { href: '/resources/suboxone-taper-calculator', label: 'Suboxone taper', Icon: Pill },
  { href: '/resources/kratom-leaf-taper-calculator', label: 'Kratom leaf taper', Icon: Leaf },
  { href: '/resources/sr-17-taper-calculator', label: 'SR-17 taper', Icon: Activity },
];
---

<BaseLayout>
  <main id="main-content">
    <section>
      <div class="mx-auto max-w-[88rem] px-4 py-11 sm:px-6 sm:py-14 lg:px-8 lg:py-16">
        <div class="mx-auto max-w-3xl text-center">
          <p class="eyebrow">Start here</p>
          <h1 class="reading-title mx-auto mt-4 max-w-3xl">
            Help quitting <span class="whitespace-nowrap">7-OH</span>
          </h1>
          <p class="mx-auto mt-5 max-w-2xl text-base leading-[1.7] text-muted-foreground sm:text-lg">
            Find withdrawal guidance, taper tools, medication references, and peer support for quitting 7-OH and related kratom synthetics.
          </p>

          <div class="mt-7 flex flex-col items-center gap-3">
            <a
              href="/start-here/how-to-quit-7-oh"
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-primary px-5 py-3 text-base font-bold text-primary-foreground transition-colors hover:bg-primary/90"
            >
              Compare quitting options
              <ArrowRight class="size-4" aria-hidden="true" />
            </a>
          </div>

          <div class="mx-auto mt-7 max-w-xl text-left">
            <SearchBox variant="inline" client:load placeholder="Search the guide…" />
          </div>
        </div>

        <div class="mx-auto mt-10 max-w-3xl">
          <RightNow />
        </div>
      </div>
    </section>

    <section class="px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
      <nav aria-label="Common starting points" class="mx-auto grid max-w-3xl gap-x-12 gap-y-2 sm:grid-cols-2">
        {immediatePaths.map(({ href, label, detail }, index) => (
          <a
            href={href}
            class:list={[
              'group grid min-h-24 grid-cols-[2.5rem_minmax(0,1fr)] gap-3 px-4 py-4 sm:px-5',
            ]}
          >
            <span class="pt-0.5 font-mono text-[0.68rem] font-bold text-primary">0{index + 1}</span>
            <span class="min-w-0">
              <span class="flex items-center gap-2 font-display text-xl font-semibold text-foreground transition-colors group-hover:text-primary">
                {label}
                <ArrowRight class="size-3.5 text-primary transition-transform group-hover:translate-x-1" aria-hidden="true" />
              </span>
              <span class="mt-1 block text-sm leading-snug text-muted-foreground">{detail}</span>
            </span>
          </a>
        ))}
      </nav>
    </section>

    <section class="bg-muted/30">
      <div class="mx-auto max-w-6xl px-4 py-11 sm:px-6 sm:py-14 lg:px-8">
        <div class="max-w-2xl">
          <p class="eyebrow">The full guide</p>
          <h2 class="mt-2 font-display text-3xl font-medium leading-tight tracking-[-0.015em] text-foreground sm:text-[2.25rem]">
            Browse by topic
          </h2>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted-foreground sm:text-base">
            Every guide, reference, and tool is two taps away.
          </p>
        </div>

        <ol class="mt-8 grid gap-x-12 sm:grid-cols-2">
          {CATEGORIES.map((category, index) => (
            <li>
              <a href={`/${category.slug}`} class="group flex min-h-[4.5rem] items-start gap-3 border-b border-border py-3.5">
                <span class="font-mono text-[0.66rem] font-bold text-muted-foreground">{String(index + 1).padStart(2, '0')}</span>
                <span class="min-w-0 flex-1">
                  <span class="flex items-baseline justify-between gap-3">
                    <span class="font-display text-[1.05rem] font-semibold tracking-[-0.005em] text-foreground group-hover:text-primary">{category.title}</span>
                    <span class="shrink-0 text-xs font-semibold tabular-nums text-muted-foreground">{counts[category.slug]} pages</span>
                  </span>
                  <span class="mt-0.5 line-clamp-1 block text-sm leading-snug text-muted-foreground">{category.blurb}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>

        <a href="/sitemap" class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-primary hover:underline">
          Complete site map <ArrowRight class="size-4" aria-hidden="true" />
        </a>
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl gap-8 px-4 py-11 sm:px-6 sm:py-14 lg:grid-cols-2 lg:px-8">
      <div>
        <p class="eyebrow">Calculators</p>
        <h2 class="mt-2 max-w-lg font-display text-2xl font-medium tracking-[-0.015em] sm:text-3xl">Taper Calculators</h2>
        <div class="mt-5 space-y-1">
          {tools.map(({ href, label, Icon }) => (
            <a href={href} class="group flex min-h-12 items-center gap-3 font-bold text-foreground transition-colors hover:text-primary">
              <Icon class="size-4.5 shrink-0 text-primary" aria-hidden="true" />
              <span>{label}</span>
              <ArrowRight class="ml-auto size-4 text-muted-foreground transition-transform group-hover:translate-x-1" aria-hidden="true" />
            </a>
          ))}
        </div>
      </div>

      <div>
        <p class="eyebrow">Peer support</p>
        <h2 class="mt-2 max-w-lg font-display text-2xl font-medium tracking-[-0.015em] sm:text-3xl">Discord and Reddit</h2>
        <p class="mt-3 max-w-lg text-sm leading-relaxed text-muted-foreground">Join the quitting7oh Discord or search past discussions on Reddit.</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="https://www.reddit.com/r/quitting7oh/" target="_blank" rel="noopener noreferrer" class="rounded-lg border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground hover:border-primary hover:bg-accent">Search Reddit</a>
          <a href="https://discord.gg/quitting7oh" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-4 py-2.5 text-sm font-bold text-foreground hover:border-primary hover:bg-accent">
            <MessageCircle class="size-4" aria-hidden="true" />
            Discord<DiscordOnlineCount client:visible />
          </a>
        </div>
      </div>

      <div class="pt-2 lg:col-span-2">
        <h2 class="text-sm font-bold text-foreground">Use these guides when you talk with a clinician.</h2>
        <p class="mt-1.5 max-w-4xl text-sm leading-relaxed text-muted-foreground">
          This is community-compiled information, not medical advice. A clinician who knows your health and other medications has context this site does not. The guides can help you understand your options and ask more specific questions.
        </p>
      </div>
    </section>
  </main>
  <div class="lg:hidden">
    <AppSidebar
      client:load
      categories={sidebarCategories}
      pinned={PINNED_PAGES}
      currentPath={Astro.url.pathname}
    />
  </div>
</BaseLayout>
