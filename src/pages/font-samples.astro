---
import BaseLayout from '~/layouts/BaseLayout.astro';

import '@fontsource-variable/source-sans-3/wght.css';
import '@fontsource-variable/source-serif-4/standard.css';
import '@fontsource-variable/literata/standard.css';
import '@fontsource-variable/inclusive-sans/wght.css';
import '@fontsource-variable/commissioner/standard.css';

const systems = [
  {
    id: 'current',
    className: 'system-current',
    name: 'Current pairing',
    heading: 'Newsreader',
    body: 'Atkinson Hyperlegible Next',
    fit: 'Warm, distinctive, and built around high body-text clarity.',
    tradeoff: 'Newsreader is gentle; technical pages may need firmer headings.',
  },
  {
    id: 'source',
    className: 'system-source',
    name: 'Source Sans + Serif',
    heading: 'Source Serif 4',
    body: 'Source Sans 3',
    fit: 'Restrained and steady, with clear hierarchy and a neutral tone.',
    tradeoff: 'We would need to build distinction elsewhere.',
  },
  {
    id: 'literata',
    className: 'system-literata',
    name: 'Literata + Atkinson',
    heading: 'Literata',
    body: 'Atkinson Hyperlegible Next',
    fit: 'Bookish and substantial, with the current accessible body face intact.',
    tradeoff: 'Headings occupy more space and carry more editorial personality.',
  },
  {
    id: 'inclusive',
    className: 'system-inclusive',
    name: 'Newsreader + Inclusive Sans',
    heading: 'Newsreader',
    body: 'Inclusive Sans',
    fit: 'Open, calm body text with fewer mechanical forms.',
    tradeoff: 'Readers may find the softer forms less authoritative in dense reference tables.',
  },
  {
    id: 'commissioner',
    className: 'system-commissioner',
    name: 'Source Serif + Commissioner',
    heading: 'Source Serif 4',
    body: 'Commissioner',
    fit: 'More rhythm and warmth than Source Sans while keeping controls compact.',
    tradeoff: 'Its personality is most visible in lowercase text; judge it over a full paragraph.',
  },
];

const sources = [
  { label: 'Atkinson Hyperlegible Next', href: 'https://www.brailleinstitute.org/freefont/' },
  { label: 'Newsreader', href: 'https://github.com/productiontype/Newsreader' },
  { label: 'Source Sans 3', href: 'https://github.com/adobe-fonts/source-sans' },
  { label: 'Source Serif 4', href: 'https://github.com/adobe-fonts/source-serif' },
  { label: 'Literata', href: 'https://github.com/googlefonts/literata' },
  { label: 'Inclusive Sans', href: 'https://github.com/LivKing/Inclusive-Sans' },
  { label: 'Commissioner', href: 'https://github.com/kosbarts/Commissioner' },
];
---

<BaseLayout title="Font Samples" description="Five typography systems tested with real quitting7oh.org reading patterns.">
  <main id="main-content">
    <header class="quiet-grid">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
        <p class="eyebrow">Typography lab</p>
        <h1 class="reading-title mt-4 max-w-4xl">Five ways this site could read</h1>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted-foreground">
          Each sample tests a heading face and body face as one system. The page repeats the same title, paragraph, list, numerals, and meeting interface at realistic sizes.
        </p>
        <a href="/font-samples-2" class="mt-6 inline-flex text-sm font-bold text-primary underline decoration-primary/35 underline-offset-4 hover:decoration-primary">
          Open the Commissioner follow-up →
        </a>

        <div class="mt-8 grid gap-5 rounded-2xl bg-muted/55 p-5 sm:grid-cols-2 sm:p-6 lg:grid-cols-4">
          <div>
            <p class="font-bold text-foreground">Scan the hierarchy</p>
            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">Section breaks should stand out at a restrained heading size.</p>
          </div>
          <div>
            <p class="font-bold text-foreground">Read the paragraph</p>
            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">Read several lines before judging the texture.</p>
          </div>
          <div>
            <p class="font-bold text-foreground">Check the characters</p>
            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">Compare 1, I, l, 0, O, dose ranges, and the 7-OH name.</p>
          </div>
          <div>
            <p class="font-bold text-foreground">Try both themes</p>
            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">A face that works on paper may become too thin against the dark palette.</p>
          </div>
        </div>

        <nav aria-label="Font systems" class="mt-8 flex flex-wrap gap-2">
          {systems.map((system, index) => (
            <a href={`#${system.id}`} class="rounded-lg border border-border bg-card px-3 py-2 text-sm font-bold text-foreground hover:border-primary hover:text-primary">
              {String(index + 1).padStart(2, '0')} · {system.name}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <div class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8">
      {systems.map((system, index) => (
        <section id={system.id} class="font-system scroll-mt-28 py-12 sm:py-16">
          <div class="mb-7 grid gap-5 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-10">
            <div>
              <p class="font-mono text-xs font-bold tracking-[0.12em] text-primary">{String(index + 1).padStart(2, '0')}</p>
              <h2 class="mt-2 font-display text-3xl font-semibold text-foreground">{system.name}</h2>
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.1em] text-muted-foreground">The pairing</p>
                <p class="mt-2 font-bold text-foreground">{system.heading} headings</p>
                <p class="text-sm text-muted-foreground">{system.body} body and interface</p>
              </div>
              <div>
                <p class="text-sm leading-relaxed text-foreground">{system.fit}</p>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground"><strong class="text-foreground">Watch for:</strong> {system.tradeoff}</p>
              </div>
            </div>
          </div>

          <article class:list={['font-preview overflow-hidden rounded-2xl border border-border bg-card shadow-sm', system.className]}>
            <header class="preview-header px-5 py-8 sm:px-8 sm:py-10 lg:px-12">
              <p class="preview-ui text-xs font-bold uppercase tracking-[0.13em] text-primary">Start here · field note</p>
              <h3 class="preview-display mt-3 max-w-3xl text-[2.4rem] font-semibold leading-[1.06] tracking-[-0.02em] text-foreground sm:text-[3.2rem]">
                Paths off 7-OH
              </h3>
              <p class="mt-4 max-w-2xl text-[1.05rem] leading-[1.68] text-muted-foreground sm:text-lg">
                Six ways people come off 7-OH and related synthetics, in the order this community would try them.
              </p>
            </header>

            <div class="preview-grid grid gap-8 px-5 py-8 sm:px-8 sm:py-10 lg:grid-cols-[minmax(0,1fr)_17rem] lg:px-12">
              <div class="preview-copy max-w-[42rem]">
                <h4 class="preview-display text-[1.8rem] font-semibold leading-tight tracking-[-0.01em] text-foreground">The first hour</h4>
                <p class="mt-5 text-base leading-[1.72] text-foreground">
                  You’re going to be okay. Even if it doesn’t feel like it right now. Withdrawal is a finite, time-limited process. Your body knows how to do this. We’re going to walk you through the next few hours.
                </p>
                <p class="mt-4 text-base leading-[1.72] text-foreground">
                  Start with the immediate needs. You do not have to make every long-term decision tonight.
                </p>
                <ul class="mt-5 space-y-3 text-base leading-[1.6] text-foreground">
                  <li class="grid grid-cols-[0.55rem_minmax(0,1fr)] gap-3"><span class="mt-[0.65em] size-1.5 rounded-full bg-primary" aria-hidden="true"></span><span><strong>Drink water.</strong> Slow sips are enough to start.</span></li>
                  <li class="grid grid-cols-[0.55rem_minmax(0,1fr)] gap-3"><span class="mt-[0.65em] size-1.5 rounded-full bg-primary" aria-hidden="true"></span><span><strong>Find a place to rest.</strong> A dark, cool room can reduce the load.</span></li>
                  <li class="grid grid-cols-[0.55rem_minmax(0,1fr)] gap-3"><span class="mt-[0.65em] size-1.5 rounded-full bg-primary" aria-hidden="true"></span><span><strong>Slow your breathing.</strong> Two minutes can take the edge off the panic.</span></li>
                  <li class="grid grid-cols-[0.55rem_minmax(0,1fr)] gap-3"><span class="mt-[0.65em] size-1.5 rounded-full bg-primary" aria-hidden="true"></span><span><strong>Tell one person.</strong> You do not need to explain everything.</span></li>
                </ul>
              </div>

              <aside class="preview-ui self-start rounded-xl bg-muted/65 p-5">
                <p class="text-xs font-bold uppercase tracking-[0.11em] text-muted-foreground">Next meeting</p>
                <p class="mt-3 text-lg font-bold leading-snug text-foreground">Today, 7:00 AM</p>
                <p class="mt-1 text-sm text-muted-foreground">Free · no signup</p>
                <a href="/next-kratom-support-meeting" class="mt-5 inline-flex min-h-11 items-center rounded-lg bg-primary px-4 py-2 text-sm font-bold text-primary-foreground">Find a meeting →</a>
                <div class="mt-5 rounded-lg bg-background/75 p-3">
                  <p class="text-[0.68rem] font-bold uppercase tracking-[0.1em] text-muted-foreground">Character check</p>
                  <p class="mt-2 text-base font-semibold tracking-[0.025em] text-foreground">1 I l · 0 O · 7-OH</p>
                  <p class="mt-1 text-sm tabular-nums text-muted-foreground">6–12 hours · 12.5 mg</p>
                </div>
              </aside>
            </div>
          </article>
        </section>
      ))}

      <section class="mt-4 rounded-2xl bg-muted/45 p-6 sm:p-8">
        <p class="eyebrow">Open-font sources</p>
        <h2 class="mt-3 font-display text-2xl font-semibold text-foreground">Shortlist sources</h2>
        <p class="mt-3 max-w-3xl text-sm leading-relaxed text-muted-foreground">
          Fontsource serves each candidate from this site. The browser fetches the font files from quitting7oh.org. The links below go to the font designers or maintaining organizations.
        </p>
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-3">
          {sources.map((source) => (
            <a href={source.href} target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-primary hover:underline">{source.label} ↗</a>
          ))}
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .font-system + .font-system {
    border-top: 1px solid hsl(var(--border));
  }

  .font-preview {
    font-family: var(--sample-body);
    font-optical-sizing: auto;
  }

  .preview-display {
    font-family: var(--sample-display);
    font-optical-sizing: auto;
  }

  .preview-ui {
    font-family: var(--sample-ui);
  }

  .system-current {
    --sample-display: 'Newsreader Variable', ui-serif, Georgia, serif;
    --sample-body: 'Atkinson Hyperlegible Next Variable', ui-sans-serif, system-ui, sans-serif;
    --sample-ui: 'Atkinson Hyperlegible Next Variable', ui-sans-serif, system-ui, sans-serif;
  }

  .system-source {
    --sample-display: 'Source Serif 4 Variable', ui-serif, Georgia, serif;
    --sample-body: 'Source Sans 3 Variable', ui-sans-serif, system-ui, sans-serif;
    --sample-ui: 'Source Sans 3 Variable', ui-sans-serif, system-ui, sans-serif;
  }

  .system-literata {
    --sample-display: 'Literata Variable', ui-serif, Georgia, serif;
    --sample-body: 'Atkinson Hyperlegible Next Variable', ui-sans-serif, system-ui, sans-serif;
    --sample-ui: 'Atkinson Hyperlegible Next Variable', ui-sans-serif, system-ui, sans-serif;
  }

  .system-inclusive {
    --sample-display: 'Newsreader Variable', ui-serif, Georgia, serif;
    --sample-body: 'Inclusive Sans Variable', ui-sans-serif, system-ui, sans-serif;
    --sample-ui: 'Inclusive Sans Variable', ui-sans-serif, system-ui, sans-serif;
  }

  .system-commissioner {
    --sample-display: 'Source Serif 4 Variable', ui-serif, Georgia, serif;
    --sample-body: 'Commissioner Variable', ui-sans-serif, system-ui, sans-serif;
    --sample-ui: 'Commissioner Variable', ui-sans-serif, system-ui, sans-serif;
  }
</style>
