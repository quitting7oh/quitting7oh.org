---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Logo from '~/components/Logo.astro';
import { Callout } from '~/components/Callout';
import { CopyBlock } from '~/components/CopyBlock';
import agentContext from '../../docs/brand/agent-context.md?raw';

const swatches = [
  { name: 'Paper', role: 'Reading background', className: 'bg-background text-foreground' },
  { name: 'Ink', role: 'Text and dark fields', className: 'bg-foreground text-background' },
  { name: 'Mulberry', role: 'Links and primary actions', className: 'bg-primary text-primary-foreground' },
  { name: 'Dust', role: 'Selected and supporting surfaces', className: 'bg-accent text-accent-foreground' },
  { name: 'Amber', role: 'Urgent and time-sensitive states', className: 'bg-signal text-signal-foreground' },
  { name: 'Sage', role: 'Live and positive states', className: 'bg-success text-success-foreground' },
];

const scale = [
  ['Display', 'font-display text-[3.6rem] font-medium leading-[1.04] tracking-[-0.022em]', 'Get steady.'],
  ['Page title', 'font-display text-[2.5rem] font-semibold leading-[1.08] tracking-[-0.018em]', 'Withdrawal help'],
  ['Section', 'font-display text-[1.55rem] font-semibold leading-[1.25]', 'The first hour'],
  ['Body', 'text-base leading-[1.7]', 'Long-form text uses measured line height, a narrow column, and a highly distinguishable sans serif.'],
  ['Interface', 'text-sm font-bold', 'Find a meeting'],
];
---

<BaseLayout title="Brand & Style Guide" description="The Field Guide visual system for quitting7oh.org.">
  <main id="main-content">
    <header class="quiet-grid border-b border-border">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-18 lg:px-8 lg:py-24">
        <p class="eyebrow">Brand and interface system</p>
        <h1 class="reading-title mt-5 max-w-4xl">A field guide built for a difficult night.</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground sm:text-xl">
          Calm paper, warm ink, and clear signals. The system puts reading comfort first and keeps urgent actions visually distinct without turning the site into a warning panel.
        </p>
      </div>
    </header>

    <div class="mx-auto max-w-6xl space-y-16 px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <section id="logo" class="grid gap-8 lg:grid-cols-[18rem_minmax(0,1fr)]">
        <div>
          <p class="eyebrow">01 · Mark</p>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight">The Lift Cup</h2>
        </div>
        <div>
          <div class="grid gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-2">
            <div class="flex min-h-52 items-center justify-center bg-card p-8"><Logo link={false} size="3.75rem" /></div>
            <div class="flex min-h-52 items-center justify-center bg-foreground p-8 [&_.logo-mark]:!bg-background/10 [&_.logo-wm]:!text-background [&_.logo-wm-tld]:!text-background/55"><Logo link={false} size="3.75rem" /></div>
          </div>
          <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground">
            The cup and upward arrow remain the fixed brand mark. The rounded field and Newsreader wordmark give it a quieter, reference-book character.
          </p>
        </div>
      </section>

      <section id="color" class="grid gap-8 border-t border-border pt-14 lg:grid-cols-[18rem_minmax(0,1fr)]">
        <div>
          <p class="eyebrow">02 · Color</p>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight">Warm, not clinical</h2>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {swatches.map((swatch) => (
            <div class:list={['flex min-h-40 flex-col justify-end rounded-xl border border-border p-4', swatch.className]}>
              <p class="font-bold">{swatch.name}</p>
              <p class="mt-1 text-xs opacity-70">{swatch.role}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="type" class="grid gap-8 border-t border-border pt-14 lg:grid-cols-[18rem_minmax(0,1fr)]">
        <div>
          <p class="eyebrow">03 · Typography</p>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight">Reading is the interface</h2>
        </div>
        <div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl border border-border bg-card p-6 sm:p-8">
              <p class="font-display text-7xl font-medium leading-none">Aa</p>
              <p class="mt-5 font-display text-2xl font-semibold">Newsreader</p>
              <p class="mt-2 text-sm text-muted-foreground">Titles and long-form headings. Editorial, warm, and compact at large sizes.</p>
            </div>
            <div class="rounded-2xl border border-border bg-card p-6 sm:p-8">
              <p class="text-7xl font-semibold leading-none">Aa</p>
              <p class="mt-5 text-2xl font-bold">Atkinson Hyperlegible Next</p>
              <p class="mt-2 text-sm text-muted-foreground">Body copy and controls. Distinct character shapes support tired eyes and low-light reading.</p>
            </div>
          </div>
          <div class="mt-4 divide-y divide-border overflow-hidden rounded-2xl border border-border bg-card">
            {scale.map(([label, className, sample]) => (
              <div class="grid gap-3 p-5 sm:grid-cols-[8rem_minmax(0,1fr)] sm:items-baseline sm:p-6">
                <p class="text-xs font-bold uppercase tracking-[0.1em] text-muted-foreground">{label}</p>
                <p class={className}>{sample}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="components" class="grid gap-8 border-t border-border pt-14 lg:grid-cols-[18rem_minmax(0,1fr)]">
        <div>
          <p class="eyebrow">04 · Components</p>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight">Obvious under stress</h2>
        </div>
        <div class="space-y-6">
          <div class="rounded-2xl border border-border bg-card p-6">
            <p class="text-sm font-bold">Actions</p>
            <div class="mt-4 flex flex-wrap gap-3">
              <button class="min-h-11 rounded-lg bg-primary px-4 py-2 text-sm font-bold text-primary-foreground">Primary action</button>
              <button class="min-h-11 rounded-lg border border-border bg-card px-4 py-2 text-sm font-bold text-foreground">Secondary action</button>
              <button class="min-h-11 rounded-lg bg-signal px-4 py-2 text-sm font-bold text-signal-foreground">Urgent action</button>
            </div>
          </div>
          <Callout type="warning" title="Safety information stays visually separate">
            Amber identifies urgency and risk. Mulberry stays reserved for navigation and ordinary actions, so the two are never confused.
          </Callout>
          <div class="grid gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-3">
            <div class="bg-card p-5"><p class="eyebrow !text-muted-foreground">Duration</p><p class="mt-2 font-display text-2xl font-semibold">21 days</p></div>
            <div class="bg-card p-5"><p class="eyebrow !text-muted-foreground">Starting dose</p><p class="mt-2 font-display text-2xl font-semibold">45 mg</p></div>
            <div class="bg-card p-5"><p class="eyebrow !text-muted-foreground">Status</p><p class="mt-2 font-display text-2xl font-semibold">Saved locally</p></div>
          </div>
        </div>
      </section>

      <section id="motion" class="grid gap-8 border-t border-border pt-14 lg:grid-cols-[18rem_minmax(0,1fr)]">
        <div>
          <p class="eyebrow">05 · Motion</p>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight">Only when useful</h2>
        </div>
        <div class="max-w-3xl text-base leading-relaxed text-muted-foreground">
          <p>Color transitions clarify hover and selection. Drawers and dialogs use short entrance transitions. The live-meeting dot is the only repeating motion. Every transition is removed when reduced motion is preferred.</p>
        </div>
      </section>

      <section id="agent" class="grid gap-8 border-t border-border pt-14 lg:grid-cols-[18rem_minmax(0,1fr)]">
        <div>
          <p class="eyebrow">06 · Agent context</p>
          <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight">Build with the same constraints</h2>
        </div>
        <CopyBlock text={agentContext} filename="agent-context.md" client:load />
      </section>
    </div>
  </main>
</BaseLayout>
